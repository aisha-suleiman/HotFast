# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456:AAAA-your-token-here
# ID закрытой группы кухни. Отрицательное число вида -1001234567890.
# Как узнать: добавьте бота в группу и отправьте туда /chatid
ADMIN_GROUP_ID=-1001234567890
# Telegram ID тех, кому доступны служебные команды (/stats, /seed_photo)
ADMIN_IDS=[111111111]

# ─── Хранилища ───────────────────────────────────────────────────────────────
# dev:  sqlite+aiosqlite:///./shawarma.db
# prod: postgresql+asyncpg://bot:bot@postgres:5432/bot
DB_URL=sqlite+aiosqlite:///./shawarma.db
# Пусто -> состояние чекаута хранится в памяти (теряется при рестарте)
REDIS_URL=

# ─── Локаль и деньги ─────────────────────────────────────────────────────────
DEFAULT_LANG=ar
# TRY или USD. Цены везде хранятся в минорных единицах (куруши / центы).
CURRENCY=TRY
TZ=Asia/Damascus
# Часы приёма заказов, допускается переход через полночь
WORKING_HOURS=10:00-22:00
# Временный круглосуточный приём заказов до указанного момента — для проверки
# бота в нерабочее время. Пусто — выключено. Пример: 2026-09-10T10:00:00+03:00
HOURS_OVERRIDE_UNTIL=

# ─── Вторая цена (конвертер валют) ───────────────────────────────────────────
# Валюта, которая показывается рядом с основной по живому курсу.
# Пустое значение полностью выключает конвертер и вторую цену.
SECONDARY_CURRENCY=USD
# Источник курса. Котировки даны к сирийскому фунту, курс TRY->USD считается
# кросс-курсом через фунт.
RATE_URL=https://sp-today.com/en
# damascus — общесирийские котировки, alhasakah — Хасаке
RATE_CITY=damascus
# sell — курс продажи (заведение не теряет на спреде), buy — покупки, mid — среднее
RATE_MODE=sell
# Как часто обновлять курс в фоне, минут
RATE_TTL_MIN=60
# Старше этого возраста курс не показываем: лучше одна цена, чем две неверных
RATE_MAX_AGE_HOURS=48

# ─── Оплата ShamCash (без API, подтверждение вручную) ────────────────────────
SHAMCASH_WALLET=0000 0000 0000 0000
SHAMCASH_HOLDER=Shawarma House
# Через сколько минут неоплаченный заказ отменяется автоматически
PAYMENT_TIMEOUT_MIN=30

# ─── Доставка ────────────────────────────────────────────────────────────────
# Тарифы по расстоянию от филиала. fee — в минорных единицах.
# Дальше последнего max_km доставка недоступна.
DELIVERY_TIERS=[{"max_km":15,"fee":6000}]
# Бесплатная доставка от суммы (0 — выключено)
FREE_DELIVERY_FROM=0
# Минимальная сумма заказа (0 — выключено)
MIN_ORDER_TOTAL=0

# ─── Vercel ──────────────────────────────────────────────────────────────────
# Секрет вебхука: бот принимает апдейты только с ним. Любая длинная случайная строка
# из латиницы, цифр, _ и - (требование Telegram).
WEBHOOK_SECRET=change-me-long-random-string
# Секрет cron-задач: Vercel сам присылает его в заголовке Authorization.
CRON_SECRET=change-me-another-long-random-string

# ─── Прочее ──────────────────────────────────────────────────────────────────
SUPPORT_CONTACT=@shawarma_support
LOG_LEVEL=INFO
